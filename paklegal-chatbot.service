[Unit]
Description=PakLegal ChatBot Gunicorn Service
After=network.target

[Service]
Type=notify
User=paklegal
Group=www-data
WorkingDirectory=/home/paklegal/Pakistan-Constitution-Chatbot
Environment="PATH=/home/paklegal/Pakistan-Constitution-Chatbot/myenv/bin"
ExecStart=/home/paklegal/Pakistan-Constitution-Chatbot/myenv/bin/gunicorn \
    --config /home/paklegal/Pakistan-Constitution-Chatbot/gunicorn_config.py \
    paklegal_chatbot.wsgi:application

# Restart policy
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
